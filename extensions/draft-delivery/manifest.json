{
  "manifest_version": 3,
  "name": "LUI 三站草稿交付",
  "version": "0.3.0",
  "description": "逐篇选择个人站、公众号或小红书，只向选中的平台交付草稿。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://creator.xiaohongshu.com/*"],
  "action": { "default_title": "打开三站草稿交付" },
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4389" }
}
