---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
  title="文章"
  description="LUI AI WORLD 的 AI 工程、源码导读与实践文章。"
  canonicalPath="/articles/"
>
  <header class="page-hero page-grid">
    <p class="page-hero__index">ARCHIVE / {String(articles.length).padStart(2, '0')}</p>
    <div>
      <p class="eyebrow">WRITING / 文章</p>
      <h1>沿着证据，<br />继续往里走。</h1>
      <p>关于 AI 工程、运行时与正在发生的项目实践。</p>
    </div>
  </header>

  <section class="archive-list" aria-label="文章列表">
    {articles.map((article, index) => <ArticleCard article={article} index={index + 1} />)}
  </section>
</BaseLayout>
