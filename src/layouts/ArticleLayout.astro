---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const date = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(article.data.publishedAt);
const sourceUrl = `https://github.com/openai/codex/commit/${article.data.sourceBaseline}`;
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonicalPath={`/articles/${article.id}/`}
  ogType="article"
  publishedAt={article.data.publishedAt}
>
  <article class="article-shell">
    <header class="article-hero page-grid">
      <div class="article-hero__rail">
        <span>FIELD NOTE</span>
        <span>NO. 001</span>
      </div>
      <div class="article-hero__main">
        <p class="eyebrow">CODEX / HARNESS / SOURCE READING</p>
        <h1>{article.data.title}</h1>
        <p class="article-dek">{article.data.description}</p>
        <div class="article-byline">
          <time datetime={article.data.publishedAt.toISOString()}>{date}</time>
          <span>{article.data.tags.join(' · ')}</span>
          <a href={sourceUrl}>源码基线 {article.data.sourceBaseline.slice(0, 10)}</a>
        </div>
      </div>
    </header>

    <div class="article-content">
      <slot />
    </div>

    <footer class="article-end">
      <span aria-hidden="true">■</span>
      <p>本文基于固定源码快照，后续版本可能已经变化。</p>
      <a class="text-link" href="/articles/">返回文章列表 <span aria-hidden="true">↗</span></a>
    </footer>
  </article>
</BaseLayout>
