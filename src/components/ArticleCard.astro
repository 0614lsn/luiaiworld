---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
  index?: number;
}

const { article, index = 1 } = Astro.props;
const date = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(article.data.publishedAt);
---

<article class="article-card">
  <div class="article-card__index" aria-hidden="true">{String(index).padStart(2, '0')}</div>
  <div class="article-card__body">
    <div class="article-card__meta">
      <time datetime={article.data.publishedAt.toISOString()}>{date}</time>
      <span>{article.data.tags.join(' / ')}</span>
    </div>
    <h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2>
    <p>{article.data.description}</p>
    <a class="text-link" href={`/articles/${article.id}/`} aria-label={`阅读《${article.data.title}》`}>
      阅读全文 <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
